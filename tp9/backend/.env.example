# Configuration du serveur
PORT=3000

# Configuration MongoDB
# Pour MongoDB local :
MONGO_URI=mongodb://localhost:27017/tp9_mern

# Pour MongoDB Atlas (cloud) :
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tp9_mern?retryWrites=true&w=majority

# Configuration JWT
# IMPORTANT: Générez une clé secrète forte et unique
# Vous pouvez utiliser : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_secret_jwt_super_securise_changez_moi

# Exemple de JWT_SECRET sécurisé (généré aléatoirement):
# JWT_SECRET=8f7d9c3e2a1b5f6e8d4c7a9b3e5f1d8c9a7b5e3f1d8c7a9b5e3f1d8c9a7b5e3f
